+    fn warm_pipelines(&mut self) {
+        let Some(path) = &self.pipeline_cache_path else { return; };
+        let Ok(metadata) = std::fs::metadata(path) else { return; };
+        if metadata.len() > 65536 { return; }
+        let Ok(bytes) = std::fs::read(path) else { return; };
+        let mut warmed = 0;
+        // Store portable pipeline descriptions, never driver binaries. Bound
+        // startup work; additional unseen variants compile on demand as usual.
+        for record in bytes.chunks_exact(3).take(32) {
+            let key = PipelineKey(u16::from_le_bytes([record[1], record[2]]));
+            if key.0 > 1023 { continue; }
+            match record[0] {
+                0 => { self.opaque_pipelines.entry(key).or_insert_with(|| render::opaque::create_pipeline(key, &self.device, &self.bg_layouts)); }
+                1 => { self.trans_pipelines.entry(key).or_insert_with(|| render::trans::create_pipeline(key, true, &self.device, &self.bg_layouts)); }
+                2 => { self.trans_no_depth_update_pipelines.entry(key).or_insert_with(|| render::trans::create_pipeline(key, false, &self.device, &self.bg_layouts)); }
+                _ => continue,
+            }
+            warmed += 1;
         }
+        println!("Dust GPU pipelines prewarmed: {warmed}");
     }
 
