+fn record_pipeline(path: &Option<std::path::PathBuf>, kind: u8, key: PipelineKey) {
+    use std::io::Write;
+    let Some(path) = path else { return; };
+    if std::fs::metadata(path).map(|m| m.len() >= 65536).unwrap_or(false) { return; }
+    if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let [lo, hi] = key.0.to_le_bytes();
+        let _ = file.write_all(&[kind, lo, hi]);
+    }
+}
+#[cfg(test)] mod dstv_pipeline_tests {
+    use super::*;
+    #[test] fn fog_and_edges_have_independent_keys() {
+        let fog = PipelineKey(0).with_fog_enabled(true);
+        let edges = PipelineKey(0).with_edge_marking_enabled(true);
+        assert_ne!(fog, edges);
+        assert!(!fog.edge_marking_enabled());
+        assert!(!edges.fog_enabled());
+    }
+}
