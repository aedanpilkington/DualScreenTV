 using namespace DebugUtils;
 
+namespace {
+bool NativeMetalProfilingEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("DSTV_METAL_PROFILE");
+        return value && value[0] != '\0' && std::strcmp(value, "0") != 0;
+    }();
+    return enabled;
+}
+
+void RecordCpuVertexProfile(double seconds, u32 submittedVertices, u32 shaderInvocations) {
+    using Clock = std::chrono::steady_clock;
+    static auto windowStart = Clock::now();
+    static double cpuSeconds = 0;
+    static u64 batches = 0, submitted = 0, invocations = 0;
+    cpuSeconds += seconds;
+    ++batches;
+    submitted += submittedVertices;
+    invocations += shaderInvocations;
+    const auto now = Clock::now();
+    const double elapsed = std::chrono::duration<double>(now - windowStart).count();
+    if (elapsed < 5.0) {
+        return;
+    }
+    std::printf("PICA CPU vertex profile: wall=%.2fs batches=%llu submitted=%llu shader_invocations=%llu cpu_ms=%.3f avg_ms/batch=%.4f avg_us/invocation=%.3f\n",
+                elapsed, static_cast<unsigned long long>(batches),
+                static_cast<unsigned long long>(submitted),
+                static_cast<unsigned long long>(invocations), cpuSeconds * 1000.0,
+                batches ? cpuSeconds * 1000.0 / batches : 0.0,
+                invocations ? cpuSeconds * 1000000.0 / invocations : 0.0);
+    windowStart = now;
+    cpuSeconds = 0;
+    batches = submitted = invocations = 0;
+}
