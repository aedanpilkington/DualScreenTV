<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Game Audio</string>
			<key>FooterText</key>
			<string>Master volume affects game audio only. Allow Other Music keeps Apple Music playing alongside games. When enabled, media-command compatibility is disabled so music keeps its playback controls.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Master Volume</string>
			<key>Key</key>
			<string>audio.volume</string>
			<key>DefaultValue</key>
			<integer>100</integer>
			<key>Values</key>
			<array>
				<integer>0</integer>
				<integer>10</integer>
				<integer>20</integer>
				<integer>30</integer>
				<integer>40</integer>
				<integer>50</integer>
				<integer>60</integer>
				<integer>70</integer>
				<integer>80</integer>
				<integer>90</integer>
				<integer>100</integer>
			</array>
			<key>Titles</key>
			<array>
				<string>0%</string>
				<string>10%</string>
				<string>20%</string>
				<string>30%</string>
				<string>40%</string>
				<string>50%</string>
				<string>60%</string>
				<string>70%</string>
				<string>80%</string>
				<string>90%</string>
				<string>100%</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Mute</string>
			<key>Key</key>
			<string>audio.mute</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key><string>PSToggleSwitchSpecifier</string>
			<key>Title</key><string>Allow Other Music</string>
			<key>Key</key><string>audio.mixWithOthers</string>
			<key>DefaultValue</key><true/>
		</dict>
	</array>
	<key>StringsTable</key>
	<string>Root</string>
</dict>
</plist>
